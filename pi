 }

#
#  Parse modes
#

while [ "$MODE" != 'finish' ]; do
    case $MODE in
        make)
            pi-make
        ;;
        install)
            pi-make
        ;;
        installpkg)
            echo "pi-installpkg"
        ;;
    esac
done
