#    cd $pkg_name
#    if [ "$(ls)" = '$pkg_name' ]; then
#    cd $pkg_name
#    fi
#    find > $var/$pkg_name
#    install -m 755 * $prefix
#    echo "Pi: package $pkg_name installed"
 }

#
#  Parse modes
#

while [ "$MODE" != 'finish' ]; do
    case $MODE in
        make)
            pi-make
        ;;
        install)
            pi-make
        ;;
        installpkg)
            echo "pi-installpkg"
        ;;
    esac
done
